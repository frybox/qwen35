/*
 * iq_tables_list.inc -- the ONE place that spells out "which tables, in which
 * order, with which element type and length".
 *
 * THE DATA IS NOT HERE, AND MUST NEVER BE
 * ---------------------------------------
 * The bytes of the twelve canonical tables are written down exactly once, as
 * `pub export const T[n] align(64)` literals in src/iq_tables.zig (generated by
 * scripts/gen_iq_tables.py).  AGENTS.md §1.0 forbids a second definition --
 * neither a `= { 0x.., .. }` initializer in a .cu nor a `__device__` array.
 * This file carries only declarations plus *geometry*, so it can be the shared
 * source of truth without becoming a copy.
 *
 * WHO EXPANDS IT
 * --------------
 *   src/kernels/cuda/iq_tables_host.c  -- `extern const T name[N];` plus one
 *        record per table (`const void *host` + `bytes`) in exactly this order;
 *        that array is what `q35_host_tables()` hands back to the .cu.
 *   src/kernels/cuda/iq_tables.cu      -- the twelve `__device__ const T *name`
 *        pointers (this order: record i of the host list is the target of
 *        pointer i) and the offsets of the single ~40 KB device buffer.
 *
 * Because both sides iterate this file, a table cannot appear on one side and
 * not the other, and the two orders cannot drift: "which index is which table"
 * is answered once, here.  Adding the 13th table to src/iq_tables.zig is one
 * line below plus the device pointer in iq_tables.cu's own name list.
 *
 * USAGE
 * -----
 * The list is expanded by a function-like macro supplied BY THE INCLUDER:
 *
 *     #define MY_VISITOR(name, elem, count) ...
 *     #include "iq_tables_list.inc"     // expands MY_VISITOR 12 times
 *     #undef MY_VISITOR
 *
 * iq_tables_list.inc defines `Q35_IQ_TABLE_LIST(X)` as the X-taking iterator
 * and `#include`s itself recursively (X-macro, the same idiom as the old
 * `Q35_TABLE_LIST` in iq_tables.cu), so an includer never writes a table name
 * more than once across *all* of its expansions.  This .inc must stay
 * includable from plain C (a .c file compiled with `gcc -std=c11` includes it),
 * so: no C++, no CUDA, no `__device__`.
 *
 * `count` is in ELEMENTS; byte size is `count * sizeof(elem)` and is computed by
 * each consumer from the element type, not maintained by hand.
 *
 * The order is the historical Q35_TABLE_LIST order, which is also the order of
 * the export block in src/iq_tables.zig.  Deliberately not alphabetical, and
 * deliberately unchanged from the previous revision, so the upload plan stays
 * diffable.
 */

#ifdef Q35_IQ_TABLE_LIST
#  error "iq_tables_list.inc: do not define Q35_IQ_TABLE_LIST yourself (only the one below exists)"
#endif

#define Q35_IQ_TABLE_LIST(X)                          \
    X(kmask_iq2xs,   uint8_t,  8)   /* ggml-common.h:509       8 B   */ \
    X(ksigns_iq2xs,  uint8_t,  128) /* ggml-common.h:513       128 B */ \
    X(ksigns64,      uint64_t, 128) /* ggml-common.h:524       1 KiB */ \
    X(iq2xxs_grid,   uint64_t, 256) /* ggml-common.h:560       2 KiB */ \
    X(iq2xs_grid,    uint64_t, 512) /* ggml-common.h:627       4 KiB */ \
    X(iq2s_grid,     uint64_t, 1024)/* ggml-common.h:758       8 KiB */ \
    X(iq3xxs_grid,   uint32_t, 256) /* ggml-common.h:1017      1 KiB */ \
    X(iq3s_grid,     uint32_t, 512) /* ggml-common.h:1052      2 KiB */ \
    X(kvalues_iq4nl, int8_t,   16)  /* ggml-common.h:1120      16 B  */ \
    X(kvalues_fp4,   int8_t,   16)  /* ggml-common.h:1126      16 B  */ \
    X(iq1s_grid,     uint64_t, 2048)/* ggml-common.h:1135   16 KiB */ \
    X(iq_pow3,       uint8_t,  6)   /* ggml-cpu/quants.c:493   6 B   */

/* Element count of the list, derived -- never typed -- so it cannot drift from
 * the list above.  An integer constant expression, valid in C and C++.
 *
 * `Q35_IQ_TABLE_COUNT_ONE` must NOT be `#undef`ed after the line below: a
 * function-like macro named inside another macro's replacement list is only
 * looked up when the outer macro is expanded, i.e. after the #undef would have
 * removed it (measured: the count then expanded to the bare identifier and the
 * per-element visitor was never applied).  It is prefixed, so it cannot collide
 * with a name an includer defines.  Adding a row above needs no edit here. */
#define Q35_HOST_TABLE_COUNT (0 Q35_IQ_TABLE_LIST(Q35_IQ_TABLE_COUNT_ONE))
#define Q35_IQ_TABLE_COUNT_ONE(name, elem, count) + 1
